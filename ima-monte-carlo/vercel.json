{
  "buildCommand": "cd webapp && npm install && npm run build",
  "outputDirectory": "webapp/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!pitches/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/pitches/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
